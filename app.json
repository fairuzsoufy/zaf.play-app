{
  "expo": {
    "name": "Zaf Play",
    "slug": "zaf-play",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.zafplay.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.zafplay.app",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F6F8",
          "image": "./assets/zaf-logo.png",
          "imageWidth": 200,
          "dark": {
            "backgroundColor": "#0B0B0F",
            "image": "./assets/zaf-logo.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Zaf Play uses your photos so you can attach your InstaPay payment screenshot to a booking.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "zafplay",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "08f3c95d-0c2a-4771-9d69-1829054ac52a"
      }
    },
    "owner": "fairuzsoufy"
  }
}
